#!/usr/bin/env bash
set -euo pipefail
printf 'spc %s\n' "$*" >> "$SMOKE_STATE_DIR/calls.log"
case "${1:-}" in
  doctor)
    if [[ "$*" == *--auto-fix* ]]; then touch "$SMOKE_STATE_DIR/doctor"; else [[ -f "$SMOKE_STATE_DIR/doctor" ]]; fi
    ;;
  download)
    touch "$SMOKE_STATE_DIR/download"
    ;;
  build)
    mkdir -p "$SPC_BUILD_ROOT/buildroot/bin"
    printf '#!/usr/bin/env bash\nprintf "PHP 8.3 smoke\\n"\n' > "$SPC_BUILD_ROOT/buildroot/bin/php"
    chmod +x "$SPC_BUILD_ROOT/buildroot/bin/php"
    touch "$SPC_BUILD_ROOT/buildroot/bin/micro.sfx"
    ;;
  micro:combine)
    while (($#)); do
      if [[ "$1" == -O ]]; then shift; output="$1"; break; fi
      shift
    done
    printf '#!/usr/bin/env bash\nprintf "spc-combined-smoke\\n"\n' > "$output"
    chmod +x "$output"
    ;;
esac
