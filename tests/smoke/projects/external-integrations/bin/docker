#!/usr/bin/env bash
set -euo pipefail
printf 'docker %s\n' "$*" >> "$SMOKE_STATE_DIR/calls.log"
case "${1:-}" in
  ps)
    [[ -f "$SMOKE_STATE_DIR/mysql-running" ]] && printf 'dev-mysql\n'
    ;;
  run)
    touch "$SMOKE_STATE_DIR/mysql-running"
    printf 'smoke-container\n'
    ;;
  kill|rm)
    rm -f "$SMOKE_STATE_DIR/mysql-running" "$SMOKE_STATE_DIR/mysql-databases"
    ;;
  exec)
    if [[ "$*" == *"SHOW DATABASES;"* ]]; then
      printf 'Database\n'
      [[ -f "$SMOKE_STATE_DIR/mysql-databases" ]] && printf 'smoke_app\nsmoke_test\n'
    elif [[ "$*" == *mysqladmin* ]]; then
      exit 0
    elif [[ "$*" == *"CREATE DATABASE"* ]]; then
      touch "$SMOKE_STATE_DIR/mysql-databases"
    fi
    ;;
  info)
    printf '{"ID":"smoke","ClientInfo":{"Context":"orbstack"}}\n'
    ;;
esac
