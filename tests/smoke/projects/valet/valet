#!/usr/bin/env bash
set -euo pipefail
printf 'valet %s\n' "$*" >> "$SMOKE_STATE_DIR/calls.log"
if [[ "${1:-}" == --version ]]; then
  printf 'Laravel Valet 4.0.0\n'
  exit
fi
case "${1:-}" in
  link|proxy)
    mkdir -p "$SMOKE_VALET_DIR/Nginx"
    printf '# generated for %s\n' "${2:-}" > "$SMOKE_VALET_DIR/Nginx/${2:-}.conf"
    ;;
  restart) touch "$SMOKE_STATE_DIR/restarted" ;;
esac
